{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "osi-owe-yeah",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @osi/owe-yeah-web dev",
    "build": "vp run --filter @osi/owe-yeah-web build",
    "preview": "vp run --filter @osi/owe-yeah-web preview",
    "type-check": "vp run --log grouped --filter \"./packages/*\" --filter \"./apps/*\" type-check",
    "test:unit": "vp run --log grouped --filter \"./packages/*\" --filter \"./apps/*\" test:unit && vp test run --project anti-slop",
    "test:nuxt": "vp run --filter @osi/owe-yeah-web test:nuxt",
    "test:e2e:db": "vp run --filter @osi/owe-yeah-web test:e2e:db",
    "test:e2e:api": "vp run --filter @osi/owe-yeah-web test:e2e:api",
    "test:e2e:ui": "vp run --filter @osi/owe-yeah-web test:e2e:ui",
    "db:generate": "vp run --filter @osi/owe-yeah-web db:generate",
    "db:migrate": "vp run --filter @osi/owe-yeah-migrator migrate",
    "lint": "vp lint && eslint .",
    "lint:fix": "vp lint --fix && eslint . --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "author": "Rafal Osieka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafalOsieka/osi.owe.yeah.git"
  },
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.8.1",
      "onFail": "download"
    }
  }
}
