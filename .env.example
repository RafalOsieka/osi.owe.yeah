# Copy to `.env` for local runs and for the production compose.

# PostgreSQL 18 connection used by the web server and the migrator (`vp run db:migrate`).
# Matches the dev database from `compose.dev.yml`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/owe_yeah
# Host port of the dev database; keep DATABASE_URL in sync when changing it.
# DEV_POSTGRES_PORT=5433

# Production compose (`compose.prod.yaml`). It builds DATABASE_URL itself from these.
# Required there; keep it URL-safe (no `@`, `/`, `:`), it is not escaped.
POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=owe_yeah
# Base URL of the Frankfurter exchange-rate API the app fetches rates from (passed to it as
# NUXT_FRANKFURTER_URL); defaults to the public one, e.g. for a self-hosted Frankfurter.
# FRANKFURTER_URL=https://api.frankfurter.dev
# Push notifications: a VAPID key pair and a contact for the push services, a `mailto:` or
# `https:` URL. Make the pair once, from the repo root (it prints a public and a private key):
#   pnpm --filter @osi/owe-yeah-web exec web-push generate-vapid-keys
# Passed to the app as NUXT_VAPID_*. Without the keys, notifications can't be turned on.
# Keep the key pair once set: a new one cuts off every subscribed device until it turns
# notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# `true` on a test environment, whose data may be wiped: every screen shows a banner saying
# so (passed to the app as NUXT_TEST_ENVIRONMENT). Off unless set.
# TEST_ENVIRONMENT=false
# Host address and port the reverse proxy forwards to.
# APP_BIND=127.0.0.1
# APP_PORT=3000
