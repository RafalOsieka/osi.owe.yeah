# Copy to `.env` for local runs and for the production compose.

# PostgreSQL 18 connection used by the web server and the migrator (`vp run db:migrate`).
# Matches the dev database from `compose.dev.yml`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/owe_yeah
# Host port of the dev database; keep DATABASE_URL in sync when changing it.
# DEV_POSTGRES_PORT=5433

# Production compose (`compose.prod.yaml`). It builds DATABASE_URL itself from these.
# Required there; keep it URL-safe (no `@`, `/`, `:`), it is not escaped.
POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=owe_yeah
# Host address and port the reverse proxy forwards to.
# APP_BIND=127.0.0.1
# APP_PORT=3000
