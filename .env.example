# Copy to `.env` for local runs. Deployed environments set these variables themselves.

# PostgreSQL 18 connection used by the web server and the migrator (`vp run db:migrate`).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/owe_yeah

# Production compose (`compose.prod.yaml`). It builds DATABASE_URL itself from these.
# POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=owe_yeah
# Host address and port the reverse proxy forwards to.
# APP_BIND=127.0.0.1
# APP_PORT=3000
